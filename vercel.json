// Two-click reset confirmation
let resetArmed = false;
let resetTimer = null;
btnReset.addEventListener('click', () => {
  if (!resetArmed) {
    resetArmed = true;
    toast('Click again to confirm reset', 'warn');
    btnReset.style.color = 'var(--sell)';
    resetTimer = setTimeout(() => {
      resetArmed = false;
      btnReset.style.color = '';
    }, 3000);
  } else {
    clearTimeout(resetTimer);
    resetArmed = false;
    btnReset.style.color = '';
    doResetSession();
  }
});

function doResetSession() {
  clearStorage();
  for (const id of ['binance', 'coinbase']) {
    const v = state[id];
    v.openPrice = null;
    v.cumDelta = 0;
    v.buyVol = 0;
    v.sellVol = 0;
    v.totalVol = 0;
    v.trades = 0;
    v.bars = [];
    v.curBar = null;
    // Keep reconnects/errors as diagnostic history
  }
  state.sessionStart = Date.now();
  needsRender.v = true;
  toast('Session reset', 'ok');
}

btnExport.addEventListener('click', doExport);

function doExport() {
  const data = {
    exportedAt: new Date().toISOString(),
    sessionStart: state.sessionStart,
    sessionElapsedMs: Date.now() - state.sessionStart,
    weights: {
      binance: VENUES.binance.weight,
      coinbase: VENUES.coinbase.weight
    },
    venues: {}
  };
  for (const id of ['binance', 'coinbase']) {
    const v = state[id];
    data.venues[id] = {
      status: v.status,
      openPrice: v.openPrice,
      last: v.last,
      cumDelta: v.cumDelta,
      buyVol: v.buyVol,
      sellVol: v.sellVol,
      totalVol: v.totalVol,
      trades: v.trades,
      reconnects: v.reconnects,
      errors: v.errors,
      bars: v.bars
    };
  }
  data.errors = errorLog.slice(-50);

  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'swiftedge-session-' + new Date().toISOString().slice(0, 19).replace(/:/g, '-') + '.json';
  a.click();
  URL.revokeObjectURL(url);
  toast('Session exported', 'ok');
}

const btnClear = $('btnClearStorage');
if (btnClear) {
  btnClear.addEventListener('click', (e) => {
    e.preventDefault();
    doResetSession();
  });
}

/* ============================================================
   19. DEBUG PANEL
   ============================================================ */
const debugPanel = $('debugPanel');
const debugLogEl = $('debugLog');
const debugClose = $('debugClose');
const debugClear = $('debugClear');
const debugCopy  = $('debugCopy');

let debugOpen = false;

function updateDebugLog() {
  const lines = [];
  lines.push('Session elapsed: ' + fmtElapsed(Date.now() - state.sessionStart));
  lines.push('');
  for (const id of ['binance', 'coinbase']) {
    const v = state[id];
    lines.push('[' + id + ']');
    lines.push('  status:     ' + v.status);
    lines.push('  lastMsgAge: ' + (v.lastMsgAt ? (Date.now() - v.lastMsgAt) + 'ms' : '—'));
    lines.push('  reconnects: ' + (v.reconnects || 0));
    lines.push('  errors:     ' + (v.errors || 0));
    lines.push('  trades:     ' + v.trades);
    lines.push('  bars:       ' + v.bars.length);
    lines.push('');
  }
  lines.push('Recent errors (' + errorLog.length + '):');
  if (errorLog.length === 0) lines.push('  (none)');
  else {
    errorLog.slice(-8).forEach(e => {
      const t = new Date(e.t).toLocaleTimeString('en-US');
      lines.push('  ' + t + ' [' + e.source + '] ' + e.msg);
    });
  }
  debugLogEl.textContent = lines.join('\n');
}

debugClose.addEventListener('click', () => {
  debugOpen = false;
  debugPanel.hidden = true;
});
debugClear.addEventListener('click', () => {
  errorLog.length = 0;
  updateDebugLog();
});
debugCopy.addEventListener('click', () => {
  const text = debugLogEl.textContent;
  if (navigator.clipboard) {
    navigator.clipboard.writeText(text).then(() => toast('Debug log copied', 'ok'));
  }
});

// Keyboard shortcut: `d` toggles debug (ignored when typing in inputs)
window.addEventListener('keydown', (e) => {
  const tag = (e.target.tagName || '').toLowerCase();
  if (tag === 'input' || tag === 'textarea' || tag === 'select') return;
  if (e.key === 'd' && !e.metaKey && !e.ctrlKey) {
    debugOpen = !debugOpen;
    debugPanel.hidden = !debugOpen;
    if (debugOpen) updateDebugLog();
  }
});


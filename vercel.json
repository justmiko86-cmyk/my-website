<script>
/* ============================================================
   BACKEND INTEGRATION POINTS
   ------------------------------------------------------------
   This build is fully frontend. The following features are
   stubbed and clearly marked for later backend integration:

   1. AUTH — add your auth provider. All user data currently
      lives in localStorage per device.
   2. PERSISTENCE — saveSession() / loadSession() write to
      localStorage. Replace with API calls for cross-device
      sync and team sharing.
   3. HISTORICAL REPLAY — bars are capped at MAX_BARS. Full
      session replay requires server-side storage.
   4. CME REAL-TIME — requires a licensed vendor feed (e.g.
      Databento, CME DataMine, Polygon). Wire your adapter
      into state.cme and add it to getComposite().
   5. ALERTS — toast() and the divergence state are local.
      Add a server-side alerting pipeline for webhook/email/SMS.
   6. MONITORING — errors are captured in errorLog. Forward
      to Sentry/Datadog via the logError() hook below.
   ============================================================ */

/* ============================================================
   1. VENUE CONFIG
   ============================================================ */
const VENUES = {
  binance: {
    id: 'binance',
    label: 'Binance Perp',
    color: '#4fe3c1',
    weight: 1.00,
    wsUrl: 'wss://fstream.binance.com/stream?streams=btcusdt@aggTrade/btcusdt@depth20@100ms',
    parse(raw) {
      if (raw.stream === 'btcusdt@aggTrade') {
        const d = raw.data;
        return {
          type: 'trade',
          trade: {
            price: parseFloat(d.p),
            size:  parseFloat(d.q),
            isBuy: !d.m,   // m=true → buyer is maker → SELL aggressor
            ts:    d.T
          }
        };
      }
      if (raw.stream === 'btcusdt@depth20@100ms') {
        const d = raw.data;
        return {
          type: 'depth',
          bids: d.bids.map(([p, s]) => [parseFloat(p), parseFloat(s)]),
          asks: d.asks.map(([p, s]) => [parseFloat(p), parseFloat(s)])
        };
      }
      return null;
    }
  },

  coinbase: {
    id: 'coinbase',
    label: 'Coinbase Spot',
    color: '#6f8cff',
    weight: 0.70,
    wsUrl: 'wss://ws-feed.exchange.coinbase.com',
    subscribe: {
      type: 'subscribe',
      product_ids: ['BTC-USD'],
      channels: ['matches', 'level2_batch']
    },
    parse(raw) {
      if (raw.type === 'match') {
        return {
          type: 'trade',
          trade: {
            price: parseFloat(raw.price),
            size:  parseFloat(raw.size),
            isBuy: raw.side === 'sell',  // side is maker; taker is opposite
            ts:    new Date(raw.time).getTime()
          }
        };
      }
      if (raw.type === 'snapshot') {
        return { type: 'snapshot', bids: raw.bids, asks: raw.asks };
      }
      if (raw.type === 'l2update') {
        return { type: 'l2update', changes: raw.changes };
      }
      return null;
    }
  }
};

const BAR_MS   = 1000;
const MAX_BARS = 120;
const STORAGE_KEY = 'swiftedge-depth-v1';
const SAVE_INTERVAL_MS = 5000;

/* ============================================================
   2. STATE
   ============================================================ */
function freshVenue() {
  return {
    last: null,
    lastTs: 0,
    lastMsgAt: 0,
    openPrice: null,
    buyVol: 0,
    sellVol: 0,
    totalVol: 0,
    cumDelta: 0,
    trades: 0,
    reconnects: 0,
    errors: 0,
    bars: [],
    curBar: null,
    book: { bids: [], asks: [] },
    status: 'connecting'
  };
}

const state = {
  binance:  freshVenue(),
  coinbase: freshVenue(),
  cme:      { status: 'delayed', last: null },
  sessionStart: Date.now()
};

const needsRender = { v: false };
let flash = { binance: 0, coinbase: 0 };

/* ============================================================
   3. STORAGE — localStorage persistence
   ============================================================ */
let storageAvailable = true;
try {
  localStorage.setItem('__sw_test__', '1');
  localStorage.removeItem('__sw_test__');
} catch (e) {
  storageAvailable = false;
}

function saveSession() {
  if (!storageAvailable) return;
  try {
    const data = {
      savedAt: Date.now(),
      sessionStart: state.sessionStart,
      weights: {
        binance: VENUES.binance.weight,
        coinbase: VENUES.coinbase.weight
      },
      venues: {}
    };
    for (const id of ['binance', 'coinbase']) {
      const v = state[id];
      data.venues[id] = {
        openPrice: v.openPrice,
        last: v.last,
        cumDelta: v.cumDelta,
        buyVol: v.buyVol,
        sellVol: v.sellVol,
        totalVol: v.totalVol,
        trades: v.trades,
        bars: v.bars.slice(-MAX_BARS)
      };
    }
    localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
  } catch (e) {
    logError('saveSession', e);
  }
}

function loadSession() {
  if (!storageAvailable) return;
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return;
    const data = JSON.parse(raw);
    if (data.sessionStart) state.sessionStart = data.sessionStart;
    if (data.weights) {
      VENUES.binance.weight  = typeof data.weights.binance  === 'number' ? data.weights.binance  : 1.00;
      VENUES.coinbase.weight = typeof data.weights.coinbase === 'number' ? data.weights.coinbase : 0.70;
    }
    for (const id of ['binance', 'coinbase']) {
      const saved = data.venues && data.venues[id];
      if (!saved) continue;
      const v = state[id];
      v.openPrice = saved.openPrice != null ? saved.openPrice : null;
      v.cumDelta  = saved.cumDelta  || 0;
      v.buyVol    = saved.buyVol    || 0;
      v.sellVol   = saved.sellVol   || 0;
      v.totalVol  = saved.totalVol  || 0;
      v.trades    = saved.trades    || 0;
      v.bars      = Array.isArray(saved.bars) ? saved.bars.slice(-MAX_BARS) : [];
      // Restore last from the most recent bar so the chart continues smoothly
      if (v.bars.length > 0) {
        v.last = v.bars[v.bars.length - 1].close;
      } else if (saved.last != null) {
        v.last = saved.last;
      }
    }
    toast('Session restored · ' + (data.venues ? Object.keys(data.venues).length : 0) + ' venue(s)', 'ok');
  } catch (e) {
    logError('loadSession', e);
  }
}

function clearStorage() {
  if (!storageAvailable) return;
  try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
}

/* ============================================================
   4. ERROR LOGGING
   ============================================================ */
const errorLog = [];

function logError(source, err) {
  const entry = {
    t: Date.now(),
    source,
    msg: err && err.message ? err.message : String(err)
  };
  errorLog.push(entry);
  if (errorLog.length > 100) errorLog.shift();
  // BACKEND HOOK: forward to Sentry/Datadog here
  // fetch('/api/errors', { method: 'POST', body: JSON.stringify(entry) });
}

window.addEventListener('error', (e) => {
  logError('window.error', { message: e.message + ' @ ' + e.filename + ':' + e.lineno });
});
window.addEventListener('unhandledrejection', (e) => {
  logError('unhandledrejection', { message: String(e.reason) });
});

/* ============================================================
   5. TOASTS
   ============================================================ */
const toastsEl = document.getElementById('toasts');

function toast(msg, kind) {
  if (!toastsEl) return;
  const el = document.createElement('div');
  el.className = 'toast ' + (kind || '');
  el.textContent = msg;
  toastsEl.appendChild(el);
  requestAnimationFrame(() => el.classList.add('in'));
  setTimeout(() => {
    el.classList.remove('in');
    setTimeout(() => el.remove(), 320);
  }, 3800);
}

/* ============================================================
   6. FEED MANAGER
   ============================================================ */
class VenueFeed {
  constructor(cfg) {
    this.cfg = cfg;
    this.ws = null;
    this.attempt = 0;
    this.timer = null;
  }

  connect() {
    if (this.timer) { clearTimeout(this.timer); this.timer = null; }
    const v = state[this.cfg.id];
    v.status = this.attempt === 0 ? 'connecting' : 'reconnecting';
    needsRender.v = true;

    let ws;
    try {
      ws = new WebSocket(this.cfg.wsUrl);
    } catch (e) {
      logError(this.cfg.id + '.connect', e);
      this.scheduleReconnect();
      return;
    }
    this.ws = ws;

    ws.onopen = () => {
      this.attempt = 0;
      v.status = 'live';
      needsRender.v = true;
      if (this.cfg.subscribe) {
        try { ws.send(JSON.stringify(this.cfg.subscribe)); } catch (e) {}
      }
      toast(this.cfg.label + ' connected', 'ok');
    };

    ws.onmessage = (evt) => {
      let raw;
      try { raw = JSON.parse(evt.data); } catch (e) { return; }
      const parsed = this.cfg.parse(raw);
      if (!parsed) return;
      handleParsed(this.cfg.id, parsed);
    };

    ws.onerror = () => {
      v.status = 'offline';
      v.errors = (v.errors || 0) + 1;
      needsRender.v = true;
      logError(this.cfg.id + '.ws', new Error('WebSocket error'));
    };

    ws.onclose = () => {
      if (v.status !== 'offline') v.status = 'reconnecting';
      needsRender.v = true;
      this.scheduleReconnect();
    };
  }

  scheduleReconnect() {
    if (this.timer) return;
    const delay = Math.min(30000, 1000 * Math.pow(2, this.attempt));
    this.attempt++;
    const v = state[this.cfg.id];
    v.reconnects = (v.reconnects || 0) + 1;
    this.timer = setTimeout(() => {
      this.timer = null;
      this.connect();
    }, delay);
  }
}

/* ============================================================
   7. MESSAGE HANDLING
   ============================================================ */
function handleParsed(venueId, p) {
  const v = state[venueId];
  v.lastMsgAt = Date.now();

  if (p.type === 'trade') {
    const t = p.trade;
    if (!isFinite(t.price) || !isFinite(t.size) || t.size <= 0) return;

    if (v.openPrice === null) v.openPrice = t.price;
    v.last = t.price;
    v.lastTs = t.ts;
    v.trades++;
    v.totalVol += t.size;
    if (t.isBuy) v.buyVol += t.size; else v.sellVol += t.size;
    v.cumDelta += t.isBuy ? t.size : -t.size;
    flash[venueId] = t.isBuy ? 1 : -1;
    setTimeout(() => { flash[venueId] = 0; needsRender.v = true; }, 380);

    if (!v.curBar) v.curBar = newBar(v);
    const b = v.curBar;
    if (t.isBuy) b.buy += t.size; else b.sell += t.size;
    b.delta = b.buy - b.sell;
    b.cum   = v.cumDelta;
    b.close = t.price;
    b.high  = Math.max(b.high, t.price);
    b.low   = Math.min(b.low, t.price);

    needsRender.v = true;
    return;
  }

  if (p.type === 'depth') {
    v.book.bids = p.bids;
    v.book.asks = p.asks;
    needsRender.v = true;
    return;
  }

  if (p.type === 'snapshot') {
    v.book.bids = p.bids.map(([price, size]) => [parseFloat(price), parseFloat(size)]);
    v.book.asks = p.asks.map(([price, size]) => [parseFloat(price), parseFloat(size)]);
    needsRender.v = true;
    return;
  }

  if (p.type === 'l2update') {
    const bidsMap = new Map(v.book.bids);
    const asksMap = new Map(v.book.asks);
    for (const [side, price, size] of p.changes) {
      const map = side === 'buy' ? bidsMap : asksMap;
      const px = parseFloat(price);
      const sz = parseFloat(size);
      if (sz === 0) map.delete(px);
      else map.set(px, sz);
    }
    v.book.bids = Array.from(bidsMap.entries()).sort((a, b) => b[0] - a[0]);
    v.book.asks = Array.from(asksMap.entries()).sort((a, b) => a[0] - b[0]);
    needsRender.v = true;
  }
}

function newBar(v) {
  const ref = v.last != null ? v.last : 0;
  return {
    buy: 0, sell: 0, delta: 0,
    cum: v.cumDelta,
    open: ref, high: ref, low: ref, close: ref
  };
}

/* ============================================================
   8. BAR LOOP
   ============================================================ */
setInterval(() => {
  ['binance', 'coinbase'].forEach(id => {
    const v = state[id];
    if (v.status !== 'live') return;
    if (v.curBar) {
      v.bars.push(v.curBar);
      if (v.bars.length > MAX_BARS) v.bars.shift();
    }
    v.curBar = newBar(v);
  });
  needsRender.v = true;
}, BAR_MS);

/* ============================================================
   9. COMPOSITE MATH
   ============================================================ */
function getComposite() {
  const b = state.binance, c = state.coinbase;
  const wB = VENUES.binance.weight;
  const wC = VENUES.coinbase.weight;
  const wSum = wB + wC;

  const binanceDelta  = b.status === 'live' ? b.cumDelta : 0;
  const coinbaseDelta = c.status === 'live' ? c.cumDelta : 0;
  const compositeDelta = wSum > 0
    ? (binanceDelta * wB + coinbaseDelta * wC) / wSum
    : 0;

  const buyVol   = b.buyVol + c.buyVol;
  const totalVol = b.totalVol + c.totalVol;
  const buyPct   = totalVol > 0 ? (buyVol / totalVol) * 100 : null;

  return { binanceDelta, coinbaseDelta, compositeDelta, buyPct };
}

function getCompositeBars() {
  const b = state.binance.bars;
  const c = state.coinbase.bars;
  const n = Math.min(b.length, c.length);
  if (n === 0) return [];
  const wB = VENUES.binance.weight;
  const wC = VENUES.coinbase.weight;
  const wSum = wB + wC;
  const out = [];
  for (let i = 0; i < n; i++) {
    const bi = b[b.length - n + i];
    const ci = c[c.length - n + i];
    if (wSum === 0) {
      out.push({ delta: 0, cum: 0 });
    } else {
      out.push({
        delta: (bi.delta * wB + ci.delta * wC) / wSum,
        cum:   (bi.cum   * wB + ci.cum   * wC) / wSum
      });
    }
  }
  return out;
}

/* ============================================================
   10. FORMATTERS
   ============================================================ */
const fmtPrice = (p) => p == null ? '—' : p.toLocaleString('en-US', {
  minimumFractionDigits: 2, maximumFractionDigits: 2
});
const fmtSigned = (n) => {
  if (n == null) return '—';
  const v = n.toFixed(3);
  return (n >= 0 ? '+' : '−') + Math.abs(v);
};
const fmtSigned2 = (n) => {
  if (n == null) return '—';
  const v = n.toFixed(2);
  return (n >= 0 ? '+' : '−') + Math.abs(v);
};
const fmtVol = (n) => {
  if (n >= 1e6) return (n / 1e6).toFixed(2) + 'M';
  if (n >= 1e3) return (n / 1e3).toFixed(2) + 'K';
  if (n >= 10)  return n.toFixed(1);
  return n.toFixed(3);
};
const fmtSize = (s) => s >= 10 ? s.toFixed(1) : s >= 1 ? s.toFixed(2) : s.toFixed(3);
const sign = (n) => n >= 0 ? 'pos' : 'neg';
const fmtElapsed = (ms) => {
  if (ms < 1000) return ms + 'ms';
  const s = Math.floor(ms / 1000);
  if (s < 60) return s + 's';
  const m = Math.floor(s / 60);
  if (m < 60) return m + 'm ' + (s % 60) + 's';
  const h = Math.floor(m / 60);
  return h + 'h ' + (m % 60) + 'm';
};

/* ============================================================
   11. CANVAS HELPERS
   ============================================================ */
function fitCanvas(canvas) {
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  const W = canvas.clientWidth;
  const H = canvas.clientHeight;
  if (!W || !H) return null;
  if (canvas.width !== Math.round(W * dpr) || canvas.height !== Math.round(H * dpr)) {
    canvas.width  = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
  }
  const ctx = canvas.getContext('2d');
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.clearRect(0, 0, W, H);
  return { ctx, W, H };
}

/* ============================================================
   12. RENDER — composite
   ============================================================ */
const $ = (id) => document.getElementById(id);

function renderComposite() {
  const c = getComposite();

  const cdEl = $('compositeDelta');
  cdEl.textContent = fmtSigned(c.compositeDelta);
  cdEl.className = sign(c.compositeDelta);

  const buyEl = $('compositeBuy');
  if (c.buyPct == null) {
    buyEl.textContent = '—';
    buyEl.style.color = 'var(--muted)';
  } else {
    buyEl.textContent = c.buyPct.toFixed(1) + '%';
    buyEl.style.color = c.buyPct >= 50 ? 'var(--binance)' : 'var(--sell)';
  }

  const maxAbs = Math.max(Math.abs(c.binanceDelta), Math.abs(c.coinbaseDelta), 1);
  const bdBin = $('bdBinance');
  bdBin.className = 'bd-fill ' + sign(c.binanceDelta);
  bdBin.style.width = Math.min(50, (Math.abs(c.binanceDelta) / maxAbs) * 50) + '%';

  const bdCb = $('bdCoinbase');
  bdCb.className = 'bd-fill ' + sign(c.coinbaseDelta);
  bdCb.style.width = Math.min(50, (Math.abs(c.coinbaseDelta) / maxAbs) * 50) + '%';

  const bvEl = $('bdBinanceVal');
  bvEl.textContent = fmtSigned2(c.binanceDelta);
  bvEl.style.color = c.binanceDelta >= 0 ? 'var(--binance)' : 'var(--sell)';
  const cvEl = $('bdCoinbaseVal');
  cvEl.textContent = fmtSigned2(c.coinbaseDelta);
  cvEl.style.color = c.coinbaseDelta >= 0 ? 'var(--coinbase)' : 'var(--sell)';

  updateStatus('stBinance', 'binance');
  updateStatus('stCoinbase', 'coinbase');
  renderHealth();
}

function updateStatus(elId, venueId) {
  const v = state[venueId];
  const el = $(elId);
  if (!el) return;
  el.className = 'st ' + (v.status === 'live' ? 'live' : v.status === 'offline' ? 'offline' : '');
  const span = el.querySelector('span');
  if (span) span.textContent = v.status;
}

function renderHealth() {
  const now = Date.now();
  const b = state.binance, c = state.coinbase;

  $('hBinanceAge').textContent  = b.lastMsgAt ? (now - b.lastMsgAt) : '—';
  $('hBinanceReconnects').textContent = b.reconnects || 0;
  $('hBinanceErrors').textContent     = b.errors || 0;

  $('hCoinbaseAge').textContent = c.lastMsgAt ? (now - c.lastMsgAt) : '—';
  $('hCoinbaseReconnects').textContent = c.reconnects || 0;
  $('hCoinbaseErrors').textContent     = c.errors || 0;

  $('hSessionElapsed').textContent = fmtElapsed(now - state.sessionStart);
}

/* ============================================================
   13. RENDER — composite mini
   ============================================================ */
const compositeMiniCanvas = $('compositeMini');
function drawCompositeMini() {
  const fit = fitCanvas(compositeMiniCanvas);
  if (!fit) return;
  const { ctx, W, H } = fit;
  const data = getCompositeBars().slice(-50);
  if (!data.length) return;

  const midY = H / 2;
  let maxAbs = 1;
  for (const b of data) maxAbs = Math.max(maxAbs, Math.abs(b.delta));
  const bw = W / data.length;
  const gap = Math.min(2, bw * 0.3);

  for (let i = 0; i < data.length; i++) {
    const b = data[i];
    const h = (Math.abs(b.delta) / maxAbs) * (H / 2 - 3);
    const x = i * bw;
    const w = Math.max(1, bw - gap);
    ctx.fillStyle = b.delta >= 0 ? 'rgba(79,227,193,.85)' : 'rgba(255,93,122,.85)';
    if (b.delta >= 0) ctx.fillRect(x + gap / 2, midY - h, w, h);
    else              ctx.fillRect(x + gap / 2, midY, w, h);
  }

  ctx.strokeStyle = 'rgba(255,255,255,.12)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(0, midY + 0.5);
  ctx.lineTo(W, midY + 0.5);
  ctx.stroke();
}

/* ============================================================
   14. RENDER — venue cards
   ============================================================ */
function renderVenueCard(venueId) {
  const v = state[venueId];
  const cap = venueId === 'binance' ? 'Binance' : 'Coinbase';

  const priceEl = $('vPrice' + cap);
  if (priceEl) {
    priceEl.textContent = v.last != null ? '$' + fmtPrice(v.last) : '—';
    if (flash[venueId] === 1) priceEl.className = 'vc-price flash-up';
    else if (flash[venueId] === -1) priceEl.className = 'vc-price flash-down';
    else priceEl.className = 'vc-price';
  }

  const chgEl = $('vChg' + cap);
  if (chgEl) {
    if (v.openPrice && v.last) {
      const pct = ((v.last - v.openPrice) / v.openPrice) * 100;
      chgEl.textContent = (pct >= 0 ? '+' : '') + pct.toFixed(2) + '%';
      chgEl.className = 'vc-chg ' + (pct >= 0 ? 'up' : 'down');
    } else {
      chgEl.textContent = '—';
      chgEl.className = 'vc-chg neutral';
    }
  }

  const dEl = $('vDelta' + cap);
  if (dEl) {
    dEl.textContent = fmtSigned(v.cumDelta);
    dEl.className = sign(v.cumDelta);
  }

  const buyEl = $('vBuy' + cap);
  if (buyEl) {
    if (v.totalVol > 0) {
      const pct = (v.buyVol / v.totalVol) * 100;
      buyEl.textContent = pct.toFixed(1) + '%';
      buyEl.style.color = pct >= 50 ? 'var(--binance)' : 'var(--sell)';
    } else {
      buyEl.textContent = '—';
      buyEl.style.color = 'var(--muted)';
    }
  }

  const tEl = $('vTrades' + cap);
  if (tEl) tEl.textContent = v.trades.toLocaleString('en-US');
  const volEl = $('vVol' + cap);
  if (volEl) volEl.textContent = fmtVol(v.totalVol) + ' BTC';

  const badge = $('vBadge' + cap);
  if (badge) {
    badge.className = 'vc-badge ' + v.status;
    badge.textContent = v.status;
  }

  renderVenueLadder(venueId, cap);
  drawVenueMini(venueId, cap);
}

function renderVenueLadder(venueId, cap) {
  const v = state[venueId];
  const el = $('vLadder' + cap);
  if (!el) return;

  if (!v.book.asks.length || !v.book.bids.length) {
    el.innerHTML = '<div class="vc-spread"><span>' + v.status + '…</span><span></span></div>';
    return;
  }

  const asks = v.book.asks.slice(0, 5);
  const bids = v.book.bids.slice(0, 5);
  const bestAsk = asks[0][0];
  const bestBid = bids[0][0];
  const spread = bestAsk - bestBid;

  let maxSize = 0;
  for (const [, s] of asks) maxSize = Math.max(maxSize, s);
  for (const [, s] of bids) maxSize = Math.max(maxSize, s);

  let html = '';
  for (let i = asks.length - 1; i >= 0; i--) {
    const [p, s] = asks[i];
    const w = Math.min(100, (s / maxSize) * 100);
    html += '<div class="vc-lvl ask"><span class="bar" style="width:' + w + '%"></span><span class="px">' + fmtPrice(p) + '</span><span class="sz">' + fmtSize(s) + '</span></div>';
  }
  html += '<div class="vc-spread"><span>spread</span><span>' + spread.toFixed(2) + '</span></div>';
  for (let i = 0; i < bids.length; i++) {
    const [p, s] = bids[i];
    const w = Math.min(100, (s / maxSize) * 100);
    html += '<div class="vc-lvl bid"><span class="bar" style="width:' + w + '%"></span><span class="px">' + fmtPrice(p) + '</span><span class="sz">' + fmtSize(s) + '</span></div>';
  }
  el.innerHTML = html;
}

function drawVenueMini(venueId, cap) {
  const canvas = $('vMini' + cap);
  if (!canvas) return;
  const fit = fitCanvas(canvas);
  if (!fit) return;
  const { ctx, W, H } = fit;
  const v = state[venueId];
  const data = v.bars.slice(-40);
  if (!data.length) return;

  const midY = H / 2;
  let maxAbs = 1;
  for (const b of data) maxAbs = Math.max(maxAbs, Math.abs(b.delta));
  const bw = W / data.length;
  const gap = Math.min(2, bw * 0.3);

  for (let i = 0; i < data.length; i++) {
    const b = data[i];
    const h = (Math.abs(b.delta) / maxAbs) * (H / 2 - 2);
    const x = i * bw;
    const w = Math.max(1, bw - gap);
    ctx.fillStyle = b.delta >= 0 ? 'rgba(79,227,193,.8)' : 'rgba(255,93,122,.8)';
    if (b.delta >= 0) ctx.fillRect(x + gap / 2, midY - h, w, h);
    else              ctx.fillRect(x + gap / 2, midY, w, h);
  }

  ctx.strokeStyle = 'rgba(255,255,255,.1)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(0, midY + 0.5);
  ctx.lineTo(W, midY + 0.5);
  ctx.stroke();
}

/* ============================================================
   15. RENDER — big cross-venue chart
   ============================================================ */
const bigCanvas = $('bigDeltaChart');
function drawBigChart() {
  const fit = fitCanvas(bigCanvas);
  if (!fit) return;
  const { ctx, W, H } = fit;

  const bBars = state.binance.bars;
  const cBars = state.coinbase.bars;
  const len = Math.min(Math.max(bBars.length, cBars.length), MAX_BARS);
  if (len < 2) return;

  const pad = { top: 16, right: 16, bottom: 28, left: 52 };
  const plotW = W - pad.left - pad.right;
  const plotH = H - pad.top - pad.bottom;

  const series = { binance: [], coinbase: [], composite: [] };
  const wB = VENUES.binance.weight, wC = VENUES.coinbase.weight;
  const wSum = wB + wC;

  for (let i = 0; i < len; i++) {
    const bIdx = bBars.length - len + i;
    const cIdx = cBars.length - len + i;
    const bv = bIdx >= 0 && bIdx < bBars.length ? bBars[bIdx] : null;
    const cv = cIdx >= 0 && cIdx < cBars.length ? cBars[cIdx] : null;
    const bvCum = bv ? bv.cum : 0;
    const cvCum = cv ? cv.cum : 0;
    series.binance.push(bvCum);
    series.coinbase.push(cvCum);
    series.composite.push(wSum > 0 ? (bvCum * wB + cvCum * wC) / wSum : 0);
  }

  let yMin = Infinity, yMax = -Infinity;
  for (const arr of [series.binance, series.coinbase, series.composite]) {
    for (const v of arr) {
      if (v < yMin) yMin = v;
      if (v > yMax) yMax = v;
    }
  }
  if (!isFinite(yMin)) { yMin = -1; yMax = 1; }
  if (yMax - yMin < 1) { const mid = (yMax + yMin) / 2; yMin = mid - 0.5; yMax = mid + 0.5; }
  const yPad = (yMax - yMin) * 0.12;
  yMin -= yPad; yMax += yPad;

  const xAt = (i) => pad.left + (i / (len - 1)) * plotW;
  const yAt = (v) => pad.top + plotH - ((v - yMin) / (yMax - yMin)) * plotH;

  ctx.strokeStyle = 'rgba(255,255,255,.05)';
  ctx.lineWidth = 1;
  const gridN = 5;
  for (let i = 0; i <= gridN; i++) {
    const y = pad.top + (plotH / gridN) * i;
    ctx.beginPath(); ctx.moveTo(pad.left, y); ctx.lineTo(pad.left + plotW, y); ctx.stroke();
    const val = yMax - ((yMax - yMin) / gridN) * i;
    ctx.fillStyle = 'rgba(136,146,168,.7)';
    ctx.font = '10px Inter, sans-serif';
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    ctx.fillText(val.toFixed(1), pad.left - 8, y);
  }

  if (yMin < 0 && yMax > 0) {
    const zeroY = yAt(0);
    ctx.strokeStyle = 'rgba(255,255,255,.14)';
    ctx.setLineDash([3, 4]);
    ctx.beginPath();
    ctx.moveTo(pad.left, zeroY);
    ctx.lineTo(pad.left + plotW, zeroY);
    ctx.stroke();
    ctx.setLineDash([]);
  }

  function drawSeries(arr, color, width) {
    if (!arr.length) return;
    ctx.beginPath();
    for (let i = 0; i < arr.length; i++) {
      const x = xAt(i);
      const y = yAt(arr[i]);
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.strokeStyle = color;
    ctx.lineWidth = width;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    ctx.stroke();

    const lastX = xAt(arr.length - 1);
    const lastY = yAt(arr[arr.length - 1]);
    ctx.beginPath();
    ctx.arc(lastX, lastY, width + 0.5, 0, Math.PI * 2);
    ctx.fillStyle = color;
    ctx.fill();
  }

  drawSeries(series.binance, '#4fe3c1', 1.6);
  drawSeries(series.coinbase, '#6f8cff', 1.6);
  drawSeries(series.composite, '#eaf0f9', 2.2);

  ctx.fillStyle = 'rgba(136,146,168,.6)';
  ctx.font = '10px Inter, sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'top';
  const steps = 4;
  for (let i = 0; i <= steps; i++) {
    const idx = Math.round((len - 1) * (i / steps));
    const x = xAt(idx);
    const secsAgo = len - 1 - idx;
    ctx.fillText(secsAgo === 0 ? 'now' : '−' + secsAgo + 's', x, pad.top + plotH + 8);
  }

  const c = getComposite();
  $('readBinance').textContent = fmtSigned(c.binanceDelta);
  $('readBinance').className = sign(c.binanceDelta);
  $('readCoinbase').textContent = fmtSigned(c.coinbaseDelta);
  $('readCoinbase').className = sign(c.coinbaseDelta);
  $('readComposite').textContent = fmtSigned(c.compositeDelta);
  $('readComposite').className = sign(c.compositeDelta);
  $('readWeights').textContent = wB.toFixed(2) + ' / ' + wC.toFixed(2);

  $('deltaClock').textContent = 'live · ' + new Date().toLocaleTimeString('en-US', {
    hour: '2-digit', minute: '2-digit', second: '2-digit'
  });
}

/* ============================================================
   16. RENDER — divergence
   ============================================================ */
const DV_THRESH = 3;

function computeDivergence() {
  const WINDOW = 30;
  const bRecent = state.binance.bars.slice(-WINDOW).reduce((s, b) => s + b.delta, 0);
  const cRecent = state.coinbase.bars.slice(-WINDOW).reduce((s, b) => s + b.delta, 0);

  const bSig = bRecent > DV_THRESH ? 'bid' : bRecent < -DV_THRESH ? 'offer' : 'neutral';
  const cSig = cRecent > DV_THRESH ? 'bid' : cRecent < -DV_THRESH ? 'offer' : 'neutral';

  let state_, tag, tone, interp;

  if (bSig === 'offer' && cSig === 'bid') {
    state_ = 'Spot bid / perp offer';
    tag = 'hedging signature';
    tone = 'warn';
    interp = '<b>Spot accumulation against perp distribution.</b> Coinbase spot is bid while Binance perps are offered — a classic hedging footprint that often precedes a squeeze. Watch for perp shorts to cover into spot strength.';
  } else if (bSig === 'bid' && cSig === 'offer') {
    state_ = 'Perp bid / spot offer';
    tag = 'leverage-led';
    tone = 'warn';
    interp = '<b>Perps bid while spot offers.</b> Leverage is leading the move — typically fragile. Watch for liquidation cascades if perp bid weakens while spot continues to sell.';
  } else if (bSig === 'bid' && cSig === 'bid') {
    state_ = 'Broad bid';
    tag = 'conviction';
    tone = 'bullish';
    interp = '<b>Both venues are bid.</b> Spot and perp flow agree — conviction-driven accumulation across venues. Historically a higher-quality signal than perp-only strength.';
  } else if (bSig === 'offer' && cSig === 'offer') {
    state_ = 'Broad offer';
    tag = 'distribution';
    tone = 'bearish';
    interp = '<b>Both venues are offered.</b> Distribution is broad-based across spot and perp. Watch for continuation unless a bid materializes at a higher-timeframe level.';
  } else {
    state_ = 'Balanced';
    tag = 'neutral';
    tone = 'neutral';
    interp = '<b>No clear directional flow across venues.</b> Waiting for a catalyst — neither spot nor perp flow has crossed the signal threshold in the last 30 seconds.';
  }

  return { state: state_, tag, tone, interp, bRecent, cRecent, bSig, cSig };
}

function renderDivergence() {
  const d = computeDivergence();

  const stateEl = $('dvState');
  stateEl.textContent = d.state;
  stateEl.className = d.tone;

  $('dvTag').textContent = d.tag;
  $('dvTag').className = 'dv-tag';

  const maxAbs = Math.max(Math.abs(d.bRecent), Math.abs(d.cRecent), 1);

  const bFill = $('dvFillBinance');
  bFill.className = 'fill ' + sign(d.bRecent);
  bFill.style.width = (Math.abs(d.bRecent) / maxAbs * 50) + '%';

  const cFill = $('dvFillCoinbase');
  cFill.className = 'fill ' + sign(d.cRecent);
  cFill.style.width = (Math.abs(d.cRecent) / maxAbs * 50) + '%';

  const bVal = $('dvValBinance');
  bVal.textContent = fmtSigned2(d.bRecent);
  bVal.className = 'val ' + sign(d.bRecent);

  const cVal = $('dvValCoinbase');
  cVal.textContent = fmtSigned2(d.cRecent);
  cVal.className = 'val ' + sign(d.cRecent);

  $('dvInterp').innerHTML = d.interp;
}

/* ============================================================
   17. MASTER RENDER LOOP
   ============================================================ */
function renderAll() {
  renderComposite();
  renderVenueCard('binance');
  renderVenueCard('coinbase');
  drawCompositeMini();
  drawBigChart();
  renderDivergence();
}

let lastRender = 0;
function loop(now) {
  if (needsRender.v && now - lastRender > 66) {
    renderAll();
    needsRender.v = false;
    lastRender = now;
  }
  requestAnimationFrame(loop);
}

